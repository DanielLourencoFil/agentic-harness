{
  "permissions": {
    "allow": [
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/backlog-inject.py\"",
            "timeout": 10,
            "statusMessage": "backlog: injecting only at the ~/Dev desk"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/skill-activation.py\"",
            "timeout": 10,
            "statusMessage": "skill-activation: linking tracked skills"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/secret-scan.py\"",
            "timeout": 10,
            "statusMessage": "secret-hygiene: scanning prompt"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/deliberation-nudge.py\"",
            "timeout": 10,
            "statusMessage": "deliberation-nudge: checking prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/env-dump-guard.py\"",
            "timeout": 10,
            "statusMessage": "secret-hygiene: checking command"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/audit-reminder.py\"",
            "timeout": 10,
            "statusMessage": "audit-reminder: checking for a completed unit"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/push-guard.py\"",
            "timeout": 10,
            "statusMessage": "push-guard: checking the push target is not the default branch"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/write-containment.py\"",
            "timeout": 10,
            "statusMessage": "containment: checking write target"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/shelf-inventory.py\"",
            "timeout": 10,
            "statusMessage": "shelf: checking what already exists"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/decision-nudge.py\"",
            "timeout": 10,
            "statusMessage": "decision-nudge: checking for a stack/deploy commitment"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/recommendation-anchor.py\"",
            "timeout": 10,
            "statusMessage": "anchoring: checking the answer declares its evidence"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/Dev/agentic-harness/home/bin/evidence-gate.py\"",
            "timeout": 10,
            "statusMessage": "evidence-gate: checking a completion claim ran something"
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": true
}
